Adw.AlertDialog sheet_name_dialog {
  heading: _("Add Sheet");
  body: _("A sheet is a folder of its own inside the workbook, so its name is a folder\'s name.");
  default-response: "name";
  close-response: "cancel";

  responses [
    cancel: _("Cancel"),
    name: _("Add") suggested,
  ]

  extra-child: Gtk.Entry sheet_name_entry {
    placeholder-text: _("Name");
    activates-default: true;
    margin-top: 12;
  };
}

Adw.AlertDialog delete_sheet_dialog {
  heading: _("Delete Sheet?");
  body: _("The sheet and its cells are deleted from the workbook folder.");
  default-response: "cancel";
  close-response: "cancel";

  responses [
    cancel: _("Cancel"),
    delete: _("Delete") destructive,
  ]
}

Adw.AlertDialog new_sheet_dialog {
  heading: _("New Workbook");
  body: _("A workbook is one file, holding every sheet and every cell of each.");
  default-response: "create";
  close-response: "cancel";

  responses [
    cancel: _("Cancel"),
    create: _("Create") suggested,
  ]

  extra-child: Gtk.Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 12;

    Gtk.Entry new_sheet_name {
      placeholder-text: _("Name");
      activates-default: true;
    }

    Gtk.Button new_sheet_location {
      child: Gtk.Label new_sheet_location_label {
        ellipsize: middle;
        label: _("Choose a folder…");
      };
    }
  };
}

// The window itself is not here.  What it shows is a function of one value --
// see Cellar.App.View -- so it is drawn by gi-gtk4-declarative rather than
// described here.  What stays is what a window is not: the menus, which name
// application actions so that a keystroke and a menu item mean one thing, and
// the dialogs, each asked once and answered once.
