using Gtk 4.0;
using Adw 1;

menu primary_menu {
  section {
    item {
      label: _("_New Workbook…");
      action: "app.new";
    }

    item {
      label: _("New _Scratch Workbook");
      action: "app.new-scratch";
    }

    item {
      label: _("_Open Workbook…");
      action: "app.open";
    }

    item {
      label: _("_Copy Workbook To…");
      action: "app.copy-to";
    }
  }

  section {
    item {
      label: _("_Add Sheet…");
      action: "app.add-sheet";
    }

    item {
      label: _("Re_name Sheet…");
      action: "app.rename-sheet";
    }

    item {
      label: _("_Delete Sheet…");
      action: "app.delete-sheet";
    }
  }

  section {
    item {
      label: _("_Recalculate");
      action: "app.recalculate";
    }

    item {
      label: _("_Clear Cell");
      action: "app.clear-cell";
    }
  }

  section {
    item {
      label: _("Move Row _Up");
      action: "app.move-row-up";
    }

    item {
      label: _("Move Row Dow_n");
      action: "app.move-row-down";
    }

    item {
      label: _("Move Column _Left");
      action: "app.move-column-left";
    }

    item {
      label: _("Move Column Righ_t");
      action: "app.move-column-right";
    }
  }

  section {
    item {
      label: _("Insert Row _Before");
      action: "app.insert-row-before";
    }

    item {
      label: _("Insert Row _After");
      action: "app.insert-row-after";
    }

    item {
      label: _("Insert Column Be_fore");
      action: "app.insert-column-before";
    }

    item {
      label: _("Insert Column A_fter");
      action: "app.insert-column-after";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Cellar");
      action: "app.about";
    }
  }
}

menu tab_menu {
  section {
    item {
      label: _("Rename Sheet…");
      action: "app.rename-sheet";
    }

    item {
      label: _("Delete Sheet…");
      action: "app.delete-sheet";
    }
  }

  section {
    item {
      label: _("Add Sheet…");
      action: "app.add-sheet";
    }
  }
}

menu line_menu {
  section {
    item {
      label: _("Insert Row Before");
      action: "app.insert-row-before";
    }

    item {
      label: _("Insert Row After");
      action: "app.insert-row-after";
    }

    item {
      label: _("Insert Column Before");
      action: "app.insert-column-before";
    }

    item {
      label: _("Insert Column After");
      action: "app.insert-column-after";
    }
  }
}

Adw.AlertDialog sheet_name_dialog {
  heading: _("Add Sheet");
  body: _("A sheet is a folder of its own inside the workbook, so its name is a folder\'s name.");
  default-response: "name";
  close-response: "cancel";

  responses [
    cancel: _("Cancel"),
    name: _("Add") suggested,
  ]

  extra-child: Gtk.Entry sheet_name_entry {
    placeholder-text: _("Name");
    activates-default: true;
    margin-top: 12;
  };
}

Adw.AlertDialog delete_sheet_dialog {
  heading: _("Delete Sheet?");
  body: _("The sheet and its cells are deleted from the workbook folder.");
  default-response: "cancel";
  close-response: "cancel";

  responses [
    cancel: _("Cancel"),
    delete: _("Delete") destructive,
  ]
}

Adw.AlertDialog new_sheet_dialog {
  heading: _("New Workbook");
  body: _("A workbook is a folder, and a Git repository worth making one of: a folder for each sheet in it, and one small file for every cell.");
  default-response: "create";
  close-response: "cancel";

  responses [
    cancel: _("Cancel"),
    create: _("Create") suggested,
  ]

  extra-child: Gtk.Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 12;

    Gtk.Entry new_sheet_name {
      placeholder-text: _("Name");
      activates-default: true;
    }

    Gtk.Button new_sheet_location {
      child: Gtk.Label new_sheet_location_label {
        ellipsize: middle;
        label: _("Choose a folder…");
      };
    }

    Gtk.CheckButton new_sheet_git {
      label: _("Initialize a Git repository");
      active: true;
    }
  };
}

Adw.ApplicationWindow main_window {
  title: _("Cellar");
  default-width: 1100;
  default-height: 720;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Cellar");
        subtitle: _("Untitled");
      };

      [start]
      Gtk.Button recalculate_button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Recalculate the sheet");
      }

      [end]
      Gtk.MenuButton {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main menu");
        menu-model: primary_menu;
        primary: true;
      }
    }

    // The tabs: one for each sheet in the workbook.
    [top]
    Adw.TabBar tab_bar {
      view: tab_view;
      autohide: false;
      expand-tabs: false;

      [end]
      Gtk.Button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add a sheet to this workbook (Ctrl+T)");
        action-name: "app.add-sheet";

        styles [
          "flat",
        ]
      }
    }

    // The cell bar: which cell is selected, and the Guile source behind it.
    [top]
    Gtk.Box cell_bar {
      spacing: 6;
      margin-start: 6;
      margin-end: 6;
      margin-top: 3;
      margin-bottom: 3;

      styles [
        "toolbar",
      ]

      Gtk.Label reference_label {
        label: "A1";
        width-chars: 6;
        xalign: 0;

        styles [
          "monospace",
          "heading",
        ]
      }

      Gtk.Separator {
        orientation: vertical;
      }

      Gtk.Label source_label {
        hexpand: true;
        xalign: 0;
        ellipsize: end;
        single-line-mode: true;
        label: _("empty — double-click a cell to write Guile");

        styles [
          "monospace",
          "dim-label",
        ]
      }

      Gtk.Button edit_button {
        label: _("Edit");
        tooltip-text: _("Edit this cell's Guile source (Enter)");
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      Gtk.Stack main_stack {
        Gtk.StackPage {
          name: "start";

          child: Adw.StatusPage {
            icon-name: "dev.enzuru.Cellar";
            title: _("Cellar");
            description: _("A workbook is a folder of small files — one for each cell — so a set of spreadsheets can be kept under version control like anything else you write.");

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Gtk.Button {
                label: _("Open Workbook…");
                action-name: "app.open";

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              Gtk.Button {
                label: _("New Workbook…");
                action-name: "app.new";

                styles [
                  "pill",
                ]
              }

              Gtk.Button {
                label: _("New Scratch Workbook");
                action-name: "app.new-scratch";

                styles [
                  "flat",
                ]
              }
            };
          };
        }

        Gtk.StackPage {
          name: "sheet";

          // Each page of this holds a scroller and a GtkColumnView built in
          // code, because a workbook has as many of them as it has sheets and
          // a .ui file can only describe one.
          child: Adw.TabView tab_view {
            hexpand: true;
            vexpand: true;
            menu-model: tab_menu;
          };
        }
      }
    };
  };
}
