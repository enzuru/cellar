using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog preferences_dialog {
  title: _("Preferences");

  Adw.PreferencesPage {
    icon-name: "document-edit-symbolic";
    title: _("Editing");

    Adw.PreferencesGroup editor_group {
      title: _("Opening a Cell Elsewhere");
      description: _("The pencil in the cell bar opens a cell in Cellar's own editor; the folder beside it (Ctrl+Shift+E) opens the cell's file in another program. That is whatever your desktop opens text files with, unless you name a command here.");

      Adw.EntryRow external_editor_command {
        title: _("Command");
      }

      Adw.ActionRow command_hint {
        subtitle: _("%s in the command is replaced by the file; without one the file is added at the end. A terminal editor needs a terminal: xterm -e vim %s");
        subtitle-lines: 4;

        styles [
          "dim-label",
        ]
      }

      Adw.ActionRow override_row {
        visible: false;
        title: _("Overridden by CELLAR_EDITOR");
        icon-name: "dialog-information-symbolic";
        subtitle-lines: 3;
      }
    }
  }
}
