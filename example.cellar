;; A Cellar sheet: an alist of cell name to Guile source.
(("A1" . "\"Item\"")
 ("B1" . "\"Qty\"")
 ("C1" . "\"Price\"")
 ("D1" . "\"Total\"")
 ("A2" . "\"Widget\"")
 ("B2" . "12")
 ("C2" . "4.5")
 ("D2" . "(* B2 C2)")
 ("A3" . "\"Gadget\"")
 ("B3" . "7")
 ("C3" . "19.99")
 ("D3" . "(* B3 C3)")
 ("A4" . "\"Doohickey\"")
 ("B4" . "3")
 ("C4" . "129")
 ("D4" . "(* B4 C4)")
 ("A6" . "\"Subtotal\"")
 ("D6" . "(sum (range 'D2 'D4))")
 ("A7" . "\"Tax\"")
 ("D7" . "(* D6 0.08)")
 ("A8" . "\"Total\"")
 ("D8" . "(+ D6 D7)")
 ("A10" . "\"Squares\"")
 ("B10" . "(apply + (map (lambda (n) (* n n)) (iota 10)))")
 ("A11" . "\"Loudest\"")
 ("B11" . "(string-upcase A4)")
 ("A12" . "\"Verdict\"")
 ("B12" . "(if (> D8 500) 'expensive 'reasonable)"))
