;; A Cellar workbook: every sheet, and every cell of each.
((format . 3)
 (active . "Budget")
 (sheets
  ("Budget"
   (rows . 100)
   (columns . 26)
   (widths)
   (cells
    ("A1" . "\"Item\"")
    ("A10" . "\"Squares\"")
    ("A11" . "\"Loudest\"")
    ("A12" . "\"Verdict\"")
    ("A2" . "\"Widget\"")
    ("A3" . "\"Gadget\"")
    ("A4" . "\"Doohickey\"")
    ("A6" . "\"Subtotal\"")
    ("A7" . "\"Tax\"")
    ("A8" . "\"Total\"")
    ("B1" . "\"Qty\"")
    ("B10" . "(apply + (map (lambda (n) (* n n)) (iota 10)))")
    ("B11" . "(string-upcase A4)")
    ("B12" . "(if (> D8 500) 'expensive 'reasonable)")
    ("B2" . "12")
    ("B3" . "7")
    ("B4" . "3")
    ("C1" . "\"Price\"")
    ("C2" . "4.5")
    ("C3" . "19.99")
    ("C4" . "129")
    ("D1" . "\"Total\"")
    ("D2" . "(* B2 C2)")
    ("D3" . "(* B3 C3)")
    ("D4" . "(* B4 C4)")
    ("D6" . "(sum (range 'D2 'D4))")
    ("D7" . "(* D6 0.08)")
    ("D8" . "(+ D6 D7)")))))
