cabal-version:      2.4
name:               cellar
version:            0.1.0
synopsis:           A spreadsheet whose cells are Guile expressions
description:
  The shell half of Cellar: the window, the folder on disk, and the tabs.
  The other half -- the kernel, which holds the sheets and evaluates the
  cells -- is a Guile program this one starts and talks to over a pipe.

license:            GPL-3.0-or-later
license-file:       LICENSE
copyright:          (c) 2026 Elias Khanzada
author:             Elias Khanzada
maintainer:         lenzuru@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wredundant-constraints
                 -- The GTK main loop and the kernel pipe are both blocking
                 -- things pretending not to be; the threaded runtime is what
                 -- lets a `select' on the pipe not stop the world.
                 -threaded

-- What every module may assume, so that no module has to say it.
--
-- GHC2024 carries ScopedTypeVariables, LambdaCase, DerivingStrategies and
-- GeneralizedNewtypeDeriving, which is why those are no longer written at the
-- top of the files that use them.
--
-- The three below are in no edition and will not be in one, because each
-- changes how an ordinary piece of syntax is read rather than adding syntax of
-- its own.
--
-- StrictData is not among them, though it was tried here.  `make build'
-- compiles the library's sources along with Cellar's in one ghc call and so
-- cannot hand the two different extensions, the library asks for StrictData
-- nowhere, and forcing it on both leaves a program that exits 0 without ever
-- showing a window.  It stays written at the top of the two modules that want
-- it.
common language
    default-language:   GHC2024
    default-extensions: OverloadedStrings
                        OverloadedLabels
                        OverloadedLists

library
    import:           warnings, language
    hs-source-dirs:   hs
    exposed-modules:  Cellar.Ref
                      Cellar.Sexp
                      Cellar.Protocol
                      Cellar.Store
                      Cellar.View
                      Cellar.Config
                      Cellar.External
                      Cellar.Client
    build-depends:    base              >= 4.17 && < 5
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , process
                    , text
                    , unix

executable cellar
    import:           warnings, language
    -- cabal asks for -O on its own, and this asks for the second level.  See
    -- the measurement in the Makefile, which had been asking for neither.
    ghc-options:      -O2
    hs-source-dirs:   hs
    main-is:          Main.hs
    other-modules:    Cellar.App
                      Cellar.App.Env
                      Cellar.App.Event
                      Cellar.App.State
                      Cellar.App.Update
                      Cellar.App.View
                      Cellar.Grid.Gestures
                      Cellar.Grid.Model
                      Cellar.Editor
                      Cellar.Watch
                      Cellar.Ref
                      Cellar.Sexp
                      Cellar.Protocol
                      Cellar.Store
                      Cellar.View
                      Cellar.Config
                      Cellar.External
                      Cellar.Client
    build-depends:    base              >= 4.17 && < 5
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , process
                    , text
                    , unix
                    , haskell-gi-base
                    , gi-glib
                    , gi-gobject
                    , gi-gio
                    , gi-gdk4
                    , gi-graphene
                    , gi-gtk4
                    , gi-adwaita
                    , gi-gtksource5
                    , gi-pango
                    , gi-gtk4-declarative
                    , gi-gtk4-declarative-adwaita
                    , gi-gtk4-declarative-app-simple
                    , pipes
                    , pipes-concurrency
                    , async
                    , stm
                    , vector

test-suite cellar-test
    import:           warnings, language
    type:             exitcode-stdio-1.0
    hs-source-dirs:   hs, test
    main-is:          Spec.hs
    other-modules:    Cellar.Ref
                      Cellar.Sexp
                      Cellar.Protocol
                      Cellar.Store
                      Cellar.View
                      Cellar.Config
                      Cellar.External
                      Cellar.Client
    build-depends:    base              >= 4.17 && < 5
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , process
                    , text
                    , unix
